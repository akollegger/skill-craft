# Copy to .env and fill in. Never commit .env.

# One key does everything: it records sessions (memory, entities and reasoning scopes) and calls the
# skills endpoints (skills:read and skills:write).
NAMS_API_KEY=

# The dedicated experiment workspace ("Skill Distillation"). Development sessions record to a different
# workspace on purpose, so recalled memory from our design talk cannot reach an experiment run. Do not
# export this in a shell where you start `claude`: the hooks read it and would record that session here.
NAMS_WORKSPACE_ID=

NAMS_BASE_URL=https://memory.neo4jlabs.com
