{
  "name": "skill-craft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo of skill distillation with Neo4j Agent Memory (NAMS)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p viz/tsconfig.json",
    "test": "vitest run",
    "dev": "tsx",
    "build:viz": "vite build -c viz/vite.config.ts",
    "dev:viz": "tsx scripts/dev-viz.ts"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.3",
    "jsdom": "^30.1.1",
    "pixi.js": "^8.21.0",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  }
}
